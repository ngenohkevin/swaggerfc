# Strapi CMS Configuration
# Default: https://swaggerfc-cms.iopulse.cloud (no env needed for production)
# For local development, uncomment:
# NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API Token (optional - only needed for protected endpoints)
# Generate from Strapi Admin > Settings > API Tokens
# STRAPI_API_TOKEN=your-api-token-here
